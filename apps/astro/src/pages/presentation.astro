  <div class="keyboard-hint">
    <kbd>←</kbd> <kbd>→</kbd> 또는 <kbd>Space</kbd> 로 이동 · <kbd>Home</kbd> 처음 · <kbd>End</kbd> 마지막
  </div>

  <script>
    (() => {
      const SLIDE_COUNT = 10;
      const container = document.getElementById('slides-container');
      const dots = document.querySelectorAll('.nav-dot');
      let current = 0;

      function getSlideIdFromHash() {
        const m = location.hash.match(/^#(\d+)$/);
        if (m) { const n = parseInt(m[1]); if (n >= 1 && n <= SLIDE_COUNT) return n - 1; }
        return -1;
      }

      function showSlide(index, updateHash = true) {
        if (index < 0) index = 0;
        if (index >= SLIDE_COUNT) index = SLIDE_COUNT - 1;
        if (index === current && updateHash === false) return;
        current = index;

        document.querySelectorAll('.slide').forEach((el, i) => {
          el.toggleAttribute('data-visible', i === current);
        });
        container.style.transform = `translateY(-${current * 100}vh)`;

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === current);
        });

        if (updateHash) {
          history.replaceState(null, '', `#${current + 1}`);
        }
      }

      function navigate(dir) {
        showSlide(current + dir);
      }

      // Keyboard
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
          e.preventDefault(); navigate(1);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault(); navigate(-1);
        } else if (e.key === 'Home') {
          e.preventDefault(); showSlide(0);
        } else if (e.key === 'End') {
          e.preventDefault(); showSlide(SLIDE_COUNT - 1);
        }
      });

      // Dot click
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => showSlide(i));
      });

      // Touch / swipe
      let touchStartX = 0, touchStartY = 0;
      document.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });
      document.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].screenX - touchStartX;
        const dy = e.changedTouches[0].screenY - touchStartY;
        if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 50) {
          dy < 0 ? navigate(1) : navigate(-1);
        }
      }, { passive: true });

      // Wheel
      let wheelTimeout = false;
      document.addEventListener('wheel', (e) => {
        if (wheelTimeout) return;
        wheelTimeout = true;
        setTimeout(() => { wheelTimeout = false; }, 600);
        if (e.deltaY > 0) navigate(1);
        else navigate(-1);
      }, { passive: true });

      // Hash change
      window.addEventListener('hashchange', () => {
        const idx = getSlideIdFromHash();
        if (idx >= 0 && idx !== current) showSlide(idx, false);
      });

      // Init
      const hashIdx = getSlideIdFromHash();
      showSlide(hashIdx >= 0 ? hashIdx : 0, true);
    })();
  </script>
