---
// Kairos AI 서비스톤 발표자료 — 10 Slides
// 디자인: Neon Cyber preset (ECC frontend-slides skill)
// 내비게이션: 키보드 방향키 / 터치 스와이프 / 휠 / 하단 dot 클릭 / 해시(#1~#10)
const slides = [
  { id: 1, section: 'cover' },
  { id: 2, section: 'overview' },
  { id: 3, section: 'problem' },
  { id: 4, section: 'features' },
  { id: 5, section: 'flow' },
  { id: 6, section: 'tech' },
  { id: 7, section: 'demo' },
  { id: 8, section: 'impact' },
  { id: 9, section: 'qa' },
  { id: 10, section: 'checklist' },
]
---

<!doctype html>
<html lang="ko" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kairos — AI Career OS | AI 서비스톤</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />
  <style>
    /* ============================================
       VIEWPORT FITTING: MANDATORY BASE STYLES
       ============================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; background: #0a0e27; color: #e2e8f0; font-family: 'Pretendard', 'Satoshi', system-ui, sans-serif; }
    .slide {
      width: 100vw; height: 100vh; height: 100dvh; overflow: hidden;
      display: flex; flex-direction: column; position: relative; flex-shrink: 0;
    }
    .slide-content {
      flex: 1; display: flex; flex-direction: column; justify-content: center;
      max-height: 100%; overflow: hidden;
      padding: clamp(1rem, 4vw, 4rem);
    }
    :root {
      --title-size: clamp(1.5rem, 5vw, 4rem);
      --h2-size: clamp(1.25rem, 3.5vw, 2.5rem);
      --h3-size: clamp(1rem, 2.5vw, 1.75rem);
      --body-size: clamp(0.75rem, 1.5vw, 1.125rem);
      --small-size: clamp(0.65rem, 1vw, 0.875rem);
      --slide-padding: clamp(1rem, 4vw, 4rem);
      --content-gap: clamp(0.5rem, 2vw, 2rem);
      --element-gap: clamp(0.25rem, 1vw, 1rem);
    }
    @media (max-height: 700px) {
      :root { --slide-padding: clamp(0.75rem, 3vw, 2rem); --content-gap: clamp(0.4rem, 1.5vw, 1rem); --title-size: clamp(1.25rem, 4.5vw, 2.5rem); --h2-size: clamp(1rem, 3vw, 1.75rem); }
    }
    @media (max-height: 600px) {
      :root { --slide-padding: clamp(0.5rem, 2.5vw, 1.5rem); --content-gap: clamp(0.3rem, 1vw, 0.75rem); --title-size: clamp(1.1rem, 4vw, 2rem); --body-size: clamp(0.7rem, 1.2vw, 0.95rem); }
      .nav-dots, .keyboard-hint { display: none !important; }
    }
    @media (max-width: 600px) {
      :root { --title-size: clamp(1.25rem, 7vw, 2.5rem); }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.2s !important; }
    }

    /* ============================================
       NEON CYBER THEME (Kairos Custom)
       ============================================ */
    .slide {
      background: linear-gradient(135deg, #0a0e27 0%, #111640 40%, #0d1b3e 100%);
    }
    .slide::before {
      content: ''; position: absolute; inset: 0;
      background:
        radial-gradient(ellipse at 20% 50%, rgba(6, 182, 212, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 20%, rgba(168, 85, 247, 0.06) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 80%, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
      pointer-events: none;
    }
    .slide::after {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(6, 182, 212, 0.5), rgba(168, 85, 247, 0.5), transparent);
    }

    .slide-number {
      position: absolute; bottom: clamp(0.5rem, 2vw, 2rem); right: clamp(0.5rem, 2vw, 2rem);
      font-family: 'Clash Display', sans-serif; font-size: clamp(0.7rem, 1.5vw, 1rem);
      color: rgba(148, 163, 184, 0.5); letter-spacing: 0.1em; z-index: 10;
    }

    h1 {
      font-family: 'Clash Display', sans-serif; font-size: var(--title-size);
      font-weight: 700; line-height: 1.1;
      background: linear-gradient(135deg, #06b6d4 0%, #a855f7 50%, #3b82f6 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    h2 {
      font-family: 'Clash Display', sans-serif; font-size: var(--h2-size); font-weight: 600;
      background: linear-gradient(135deg, #06b6d4, #a855f7);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; margin-bottom: var(--element-gap);
    }
    h3 { font-family: 'Clash Display', sans-serif; font-size: var(--h3-size); font-weight: 600; color: #e2e8f0; }
    p, li { font-size: var(--body-size); line-height: 1.6; color: #94a3b8; }
    strong { color: #f1f5f9; font-weight: 600; }

    .subtitle {
      font-size: clamp(0.9rem, 1.8vw, 1.4rem); color: #64748b; margin-top: 0.5em;
      font-weight: 400;
    }
    .tagline {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.4em 1em; border-radius: 999px;
      background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.2);
      font-size: var(--small-size); color: #67e8f9; margin-bottom: var(--content-gap);
    }
    .tagline.cyan { background: rgba(6, 182, 212, 0.1); border-color: rgba(6, 182, 212, 0.2); color: #67e8f9; }
    .tagline.purple { background: rgba(168, 85, 247, 0.1); border-color: rgba(168, 85, 247, 0.2); color: #d8b4fe; }

    .badge {
      display: inline-block; padding: 0.2em 0.6em; border-radius: 6px;
      font-size: var(--small-size); font-weight: 500;
    }
    .badge.cyan { background: rgba(6, 182, 212, 0.15); color: #67e8f9; border: 1px solid rgba(6, 182, 212, 0.2); }
    .badge.purple { background: rgba(168, 85, 247, 0.15); color: #d8b4fe; border: 1px solid rgba(168, 85, 247, 0.2); }
    .badge.blue { background: rgba(59, 130, 246, 0.15); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.2); }
    .badge.green { background: rgba(34, 197, 94, 0.15); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.2); }
    .badge.amber { background: rgba(251, 191, 36, 0.15); color: #fde68a; border: 1px solid rgba(251, 191, 36, 0.2); }
    .badge.red { background: rgba(248, 113, 113, 0.15); color: #fca5a5; border: 1px solid rgba(248, 113, 113, 0.2); }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: clamp(0.5rem, 1.5vw, 1rem); }
    .grid-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); }
    .grid-4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); }

    .card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(148, 163, 184, 0.1);
      border-radius: 16px; padding: clamp(0.8rem, 2vw, 1.5rem);
      backdrop-filter: blur(10px); transition: border-color 0.3s, transform 0.3s;
    }
    .card:hover { border-color: rgba(6, 182, 212, 0.3); transform: translateY(-2px); }
    .card h3 { font-size: clamp(0.85rem, 1.5vw, 1.2rem); margin-bottom: 0.4em; }
    .card p, .card li { font-size: clamp(0.65rem, 1.2vw, 0.9rem); color: #94a3b8; }
    .card .stat {
      font-family: 'Clash Display', sans-serif; font-size: clamp(1.5rem, 4vw, 3rem);
      font-weight: 700; line-height: 1;
      background: linear-gradient(135deg, #06b6d4, #a855f7);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .card .stat-label { font-size: var(--small-size); color: #64748b; margin-top: 0.3em; }

    .stat-row { display: flex; gap: clamp(0.5rem, 2vw, 2rem); flex-wrap: wrap; justify-content: center; }
    .stat-item { text-align: center; padding: clamp(0.5rem, 1.5vw, 1rem); }
    .stat-item .number {
      font-family: 'Clash Display', sans-serif; font-size: clamp(1.2rem, 3vw, 2.5rem);
      font-weight: 700;
    }
    .stat-item .number.red { color: #fca5a5; }
    .stat-item .number.amber { color: #fde68a; }
    .stat-item .number.cyan { color: #67e8f9; }
    .stat-item .label { font-size: var(--small-size); color: #64748b; }

    .flow-arrow {
      display: flex; align-items: center; justify-content: center;
      font-size: clamp(1rem, 2vw, 1.5rem); color: #06b6d4;
    }

    .tech-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
      gap: clamp(0.4rem, 1vw, 0.75rem);
    }
    .tech-item {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(148, 163, 184, 0.08);
      border-radius: 12px; padding: clamp(0.5rem, 1.2vw, 1rem);
      text-align: center;
    }
    .tech-item .name { font-size: clamp(0.7rem, 1.2vw, 0.9rem); font-weight: 600; color: #e2e8f0; }
    .tech-item .desc { font-size: clamp(0.55rem, 0.9vw, 0.75rem); color: #64748b; margin-top: 0.2em; }

    .cover-logo {
      font-family: 'Clash Display', sans-serif; font-size: clamp(2rem, 6vw, 5rem);
      font-weight: 700; line-height: 1;
      background: linear-gradient(135deg, #06b6d4 0%, #a855f7 40%, #f59e0b 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .highlight-box {
      border-left: 3px solid #06b6d4; padding: clamp(0.5rem, 1.5vw, 1rem) clamp(0.8rem, 2vw, 1.5rem);
      background: rgba(6, 182, 212, 0.05); border-radius: 0 12px 12px 0;
      margin-bottom: var(--element-gap);
    }
    .highlight-box p { color: #cbd5e1; font-size: clamp(0.7rem, 1.3vw, 1rem); }

    .demo-frame {
      width: 100%; max-width: 800px; aspect-ratio: 16/9;
      border-radius: 12px; border: 1px solid rgba(148, 163, 184, 0.15);
      background: rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center;
      margin: 0 auto;
    }
    .demo-frame p { font-size: var(--body-size); color: #64748b; }

    .checklist-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.5em 0; }
    .checklist-item .box {
      width: 1.2em; height: 1.2em; border: 2px solid rgba(148, 163, 184, 0.3);
      border-radius: 4px; flex-shrink: 0;
    }

    /* Navigation */
    .nav-dots {
      position: fixed; right: clamp(0.5rem, 2vw, 2rem); top: 50%; transform: translateY(-50%);
      display: flex; flex-direction: column; gap: 0.5rem; z-index: 100;
    }
    .nav-dot {
      width: 10px; height: 10px; border-radius: 50%; border: none; cursor: pointer;
      background: rgba(148, 163, 184, 0.2); transition: all 0.3s; padding: 0;
    }
    .nav-dot.active { background: #06b6d4; box-shadow: 0 0 12px rgba(6, 182, 212, 0.5); }
    .nav-dot:hover { background: rgba(6, 182, 212, 0.5); }

    .keyboard-hint {
      position: fixed; bottom: clamp(0.5rem, 2vw, 1.5rem); left: 50%; transform: translateX(-50%);
      font-size: clamp(0.5rem, 0.8vw, 0.75rem); color: rgba(148, 163, 184, 0.3);
      z-index: 100; letter-spacing: 0.1em; text-align: center;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .keyboard-hint kbd {
      display: inline-block; padding: 0.15em 0.5em; border-radius: 4px;
      background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.2);
      font-size: inherit; font-family: inherit;
    }

    #slides-container {
      display: flex; flex-direction: column;
      transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      height: 100vh;
    }

    .slide[data-visible] { opacity: 1; }
    .slide:not([data-visible]) { opacity: 0; position: absolute; pointer-events: none; }

    /* QA slide */
    .qa-card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(148, 163, 184, 0.1);
      border-radius: 16px; padding: clamp(1rem, 3vw, 2.5rem);
      text-align: center; max-width: 600px; margin: 0 auto;
    }
    .qa-card .q { font-size: var(--h3-size); color: #e2e8f0; margin-bottom: 1em; }
    .qa-card .a { font-size: var(--body-size); color: #94a3b8; line-height: 1.8; }
  </style>
</head>
<body>
  <div id="slides-container">
    <!-- SLIDE 1: COVER -->
    <section class="slide" id="slide-1" data-visible>
      <div class="slide-content" style="align-items:center;text-align:center;">
        <span class="tagline cyan" style="margin-bottom:clamp(1rem,3vw,2rem);">2026 SW미래채움 × AI·SW중심대학 연합 경진대회</span>
        <div class="cover-logo">Kairos</div>
        <h1 style="font-size:clamp(1.2rem,3vw,2.2rem);margin-top:0.3em;">AI Career Operating System</h1>
        <p class="subtitle" style="margin-top:clamp(0.5rem,2vw,1.5rem);">AI로 커리어의 결정적 순간을 포착하다</p>
        <div style="margin-top:clamp(1rem,3vw,2.5rem);display:flex;gap:clamp(0.5rem,2vw,2rem);flex-wrap:wrap;justify-content:center;">
          <span class="badge cyan">트랙: AI 서비스톤</span>
          <span class="badge purple">팀: Kairos</span>
          <span class="badge blue">서비스: kairos.service.rhee.life</span>
        </div>
        <p style="margin-top:clamp(1.5rem,4vw,3rem);font-size:var(--small-size);color:#475569;">발표자: (팀원명) · 2026</p>
      </div>
      <span class="slide-number">01 / 10</span>
    </section>

    <!-- SLIDE 2: SERVICE OVERVIEW -->
    <section class="slide" id="slide-2">
      <div class="slide-content">
        <span class="tagline cyan" style="margin-bottom:var(--content-gap);">01 / 09 · 서비스 개요</span>
        <h2>AI가 대신하는<br/>커리어 전략</h2>
        <p style="max-width:720px;margin-bottom:var(--content-gap);">Kairos는 <strong>Google Gemini AI</strong>와 <strong>pgvector 시맨틱 검색</strong>으로 이력서 분석, 모의면접, ATS 최적화를 하나의 플랫폼에서 제공합니다.</p>
        <div class="grid" style="margin-top:var(--element-gap);">
          <div class="card" style="text-align:center;">
            <div class="stat">3</div>
            <div class="stat-label">단계 이력서 개선<br/>Draft → Evaluate → Improve</div>
          </div>
          <div class="card" style="text-align:center;">
            <div class="stat">SSE</div>
            <div class="stat-label">실시간 AI 모의면접<br/>스트리밍 응답 + 피드백</div>
          </div>
          <div class="card" style="text-align:center;">
            <div class="stat">1536</div>
            <div class="stat-label">차원 pgvector<br/>경력 시맨틱 검색</div>
          </div>
          <div class="card" style="text-align:center;">
            <div class="stat">4</div>
            <div class="stat-label">레이어 AI 가드레일<br/>안전한 LLM 운영</div>
          </div>
        </div>
      </div>
      <span class="slide-number">02 / 10</span>
    </section>

    <!-- SLIDE 3: PROBLEM BACKGROUND -->
    <section class="slide" id="slide-3">
      <div class="slide-content">
        <span class="tagline red" style="margin-bottom:var(--content-gap);">02 / 09 · 문제 배경</span>
        <h2>청년 고용 위기,<br/>더 이상 개인의 문제가 아니다</h2>
        <div class="stat-row" style="margin-bottom:var(--content-gap);">
          <div class="stat-item">
            <div class="number red">6.1%</div>
            <div class="label">청년 실업률 (2025)<br/>3년만에 최고치</div>
          </div>
          <div class="stat-item">
            <div class="number amber">48.5만</div>
            <div class="label">'쉬었음' 청년<br/>역대 최대 규모</div>
          </div>
          <div class="stat-item">
            <div class="number cyan">17.4%</div>
            <div class="label">체감 실업률<br/>확장실업률 기준</div>
          </div>
          <div class="stat-item">
            <div class="number red">22개월</div>
            <div class="label">청년 고용률<br/>연속 하락</div>
          </div>
        </div>
        <div class="grid grid-3">
          <div class="card">
            <h3>🏢 미스매치</h3>
            <p>청년 34.1%가 <strong>"원하는 일자리가 없어서"</strong> 구직 포기.<br/>정보통신업 구직자 과잉 vs 건설업 인력 부족.</p>
            <p style="margin-top:0.5em;font-size:var(--small-size);color:#64748b;">출처: 한국노동연구원 (2026)</p>
          </div>
          <div class="card">
            <h3>🤖 AI 대체</h3>
            <p>AI 도입으로 <strong>신입 채용 수요 감소</strong>, 경력직 선호 심화.<br/>중견기업 경력직 채용 비중 20.6% → 25.2%.</p>
            <p style="margin-top:0.5em;font-size:var(--small-size);color:#64748b;">출처: 한국일보 고용24 분석</p>
          </div>
          <div class="card">
            <h3>⏳ 취업 지연</h3>
            <p>첫 취업까지 평균 <strong>11.5개월</strong> (역대 최장).<br/>졸업 후 1년 이상 미취업 46.6%.</p>
            <p style="margin-top:0.5em;font-size:var(--small-size);color:#64748b;">출처: 국가데이터처</p>
          </div>
        </div>
      </div>
      <span class="slide-number">03 / 10</span>
    </section>

    <!-- SLIDE 4: KEY FEATURES -->
    <section class="slide" id="slide-4">
      <div class="slide-content">
        <span class="tagline purple" style="margin-bottom:var(--content-gap);">03 / 09 · 주요 기능</span>
        <h2>커리어 전 생애를<br/>6가지 AI 도구로</h2>
        <div class="grid grid-3" style="margin-top:var(--element-gap);">
          <div class="card">
            <h3>📄 Resume Studio</h3>
            <p>3-stage 파이프라인: Draft → LLM Evaluate → STAR Improve. 변경사항 Diff 확인 및 1-Click 적용.</p>
          </div>
          <div class="card">
            <h3>🎤 Mock Interview</h3>
            <p>SSE 실시간 스트리밍 면접. 난이도별 질문 생성, 답변 평가, 점수 피드백.</p>
          </div>
          <div class="card">
            <h3>📊 ATS Analyzer</h3>
            <p>80+ 스킬, 7개 카테고리 기반 JD 매칭. 키워드 분석 및 맞춤형 개선 추천.</p>
          </div>
          <div class="card">
            <h3>✍️ Text Humanizer</h3>
            <p>AI 생성 텍스트를 자연스러운 인간 어체로 변환. 스타일 점수 + 변경사항 요약.</p>
          </div>
          <div class="card">
            <h3>💬 Q&A Generator</h3>
            <p>직무별 맞춤 면접 질문 + 모범 답변 + 핵심 포인트 + 난이도 자동 생성.</p>
          </div>
          <div class="card">
            <h3>🔍 Semantic Search</h3>
            <p>pgvector 1536차원 임베딩. 경력·이력서·커리어 데이터 시맨틱 검색.</p>
          </div>
        </div>
      </div>
      <span class="slide-number">04 / 10</span>
    </section>

    <!-- SLIDE 5: USER FLOW -->
    <section class="slide" id="slide-5">
      <div class="slide-content">
        <span class="tagline cyan" style="margin-bottom:var(--content-gap);">04 / 09 · 사용자 이용 흐름</span>
