---
const { title } = Astro.props
---

<!doctype html>
<html lang="ko" data-seed-color-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title || 'Kairos'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style="background-color: var(--color-bg-neutral-default); color: var(--color-fg-neutral); margin: 0; font-family: system-ui, sans-serif;">
    <slot />
  </body>
</html>
