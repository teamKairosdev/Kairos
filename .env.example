# Kairos Environment Variables

# Node & App Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL with pgvector extension enabled)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kairos

# Security & Sessions
NUXT_SESSION_PASSWORD=kairos-session-super-secret-key-32-chars-minimum
JWT_SECRET=kairos-jwt-secret-key-2026-hyper-secure

# LLM Providers (Vercel AI SDK Fallback: OpenAI -> Anthropic -> Google)
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy-your-google-gemini-api-key
