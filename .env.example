# =============================================================================
# Kairos — Environment Variables
# =============================================================================
# cp .env.example .env 후 값을 채워서 사용하세요.

# ── Google Gemini (AI) ───────────────────────────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Vercel AI Gateway (optional) ──────────────────────────────────────
# Uncomment when using the gateway instead of direct Gemini requests.
# VERCEL_AI_GATEWAY_URL=
# VERCEL_AI_GATEWAY_KEY=

# ── PostgreSQL (local development) ───────────────────────────────────
# Local PostgreSQL 16 with pgvector. Replace all POSTGRES_* placeholders.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5432/POSTGRES_DB

# ── Vercel Blob Storage ──────────────────────────────────────────────
# Vercel 대시보드 > Storage > Blob에서 발급
# BLOB_READ_WRITE_TOKEN=

# ── GCP OAuth2 (Google 로그인 직접 연동) ────────────────────────────
# GCP Console > APIs & Services > Credentials에서 발급
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── JWT 세션 시크릿 ────────────────────────────────────────────────
# 최소 32자 이상의 무작위 문자열. openssl rand -base64 32
JWT_SECRET=

# ── Public App URL ─────────────────────────────────────────────────
# OAuth2 redirect URI 등에 사용. 미설정 시 기본값 http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Public career APIs (optional) ─────────────────────────────────────
# Only providers with a non-empty server-side key are called by Context sync.
# Keys are never accepted from the browser and are not stored in the database.
# WORKNET_API_KEY=
# WORKNET_OPEN_API_KEY=
# EMPLOYMENT24_API_KEY=
# EMP24_API_KEY=
# WORK24_API_KEY=
# QNET_API_KEY=
# QNET_SERVICE_KEY=
# DART_API_KEY=
# OPENDART_API_KEY=

# -----------------------------------------------------------------------------
# HWP Editor Studio (optional) ------------------------------------------------
# @rhwp/editor iframe studio URL. Unset = public demo (edwardkim.github.io).
# For confidential docs, self-host rhwp-studio and uncomment this variable:
# NEXT_PUBLIC_RHWP_STUDIO_URL=
