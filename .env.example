# Kairos Environment Variables

# Node & App Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (Neon Postgres with pgvector extension)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kairos

# Security & Sessions (Better Auth / Nuxt Session)
NUXT_SESSION_PASSWORD=<generate-32-char-random-string>
POSTGRES_PASSWORD=postgrespassword

# LLM Providers (Vercel AI SDK Fallback: Anthropic -> OpenAI -> Google)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
OPENAI_API_KEY=sk-proj-your-openai-api-key
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy-your-google-gemini-api-key

# Google AI API Key (fallback if GOOGLE_GENERATIVE_AI_API_KEY not set)
GOOGLE_API_KEY=AIzaSy-your-google-gemini-api-key

# API Endpoint URLs (optional — built-in defaults used if unset)
# OPENAI_API_URL=https://api.openai.com/v1
# ANTHROPIC_API_URL=https://api.anthropic.com/v1
# GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta
# TOSS_API_URL=https://api.tosspayments.com/v1

# Upstash Redis (Rate Limiting + LLM Caching + Semantic Vector)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
UPSTASH_VECTOR_REST_URL=https://your-upstash-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-vector-token

# Toss Payments (https://docs.tosspayments.com)
TOSS_CLIENT_KEY=test_ck_your-toss-client-key
TOSS_SECRET_KEY=test_sk_your-toss-secret-key

# Social Login (OAuth)
# Google OAuth 2.0 - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Kakao OAuth - https://developers.kakao.com/apps
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# Web Push (VAPID Keys for PWA Push Notifications)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@kairos.app
