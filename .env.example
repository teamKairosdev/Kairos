# =============================================================================
# Kairos — Environment Variables
# =============================================================================
# cp .env.example .env 후 값을 채워서 사용하세요.

# ── Google Gemini (AI) ───────────────────────────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Vercel AI Gateway ────────────────────────────────────────────────
# Vercel 대시보드 > AI > Gateway에서 발급
# 설정 시 모든 AI SDK 호출이 Gateway를 경유합니다 (캐싱, 로깅, 비용 추적)
VERCEL_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_KEY=

# ── NeonDB (PostgreSQL + pgvector) ──────────────────────────────────
# Neon 콘솔: https://console.neon.tech
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Vercel Blob Storage ──────────────────────────────────────────────
# Vercel 대시보드 > Storage > Blob에서 발급
BLOB_READ_WRITE_TOKEN=

# ── GCP OAuth2 (Google 로그인 직접 연동) ────────────────────────────
# GCP Console > APIs & Services > Credentials에서 발급
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JWT 세션 시크릿 ────────────────────────────────────────────────
# 최소 32자 이상의 무작위 문자열. openssl rand -base64 32
JWT_SECRET=

# ── Payload CMS ────────────────────────────────────────────────────
# Payload 관리자 시크릿 및 DB 연결 (NeonDB 공유 가능)
PAYLOAD_SECRET=
PAYLOAD_DATABASE_URL=

# -----------------------------------------------------------------------------
# HWP Editor Studio (optional) ------------------------------------------------
# @rhwp/editor iframe studio URL. Unset = public demo (edwardkim.github.io).
# For confidential docs, self-host rhwp-studio and point here:
#   NEXT_PUBLIC_RHWP_STUDIO_URL=https://your-studio-domain.com/
NEXT_PUBLIC_RHWP_STUDIO_URL=
