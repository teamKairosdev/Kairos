# =============================================================================
# Kairos — Environment Variables
# =============================================================================
# .env 파일로 복사해서 사용하세요.
# 단 하나의 LLM API 키만 있으면 모든 AI 기능이 작동합니다.

# ── LLM Provider (셋 중 하나만 필수) ──────────────────────────────────────
# 우선순위: Anthropic > OpenAI > Google
# AI SDK v7이 내부적으로 API 호출을 관리합니다.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/kairos

# ── Security ────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=

# ── Toss Payments (선택) ───────────────────────────────────────────────────
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── Social Login OAuth (선택) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── Upstash Redis (선택) ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── VAPID Web Push (선택) ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kairos.app
