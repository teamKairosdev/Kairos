# =============================================================================
# Kairos — Environment Variables
# =============================================================================
# .env 파일로 복사해서 사용하세요.

# ── LLM Provider (Gemini) ───────────────────────────────────────────
# Google Gemini API key. Vercel AI Gateway를 사용하면 이 키가 Gateway를 통해 사용됩니다.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Vercel AI Gateway ───────────────────────────────────────────────
# 설정 시 모든 AI SDK 호출이 Gateway URL을 경유합니다 (SSRF 방지, 캐싱, 로깅).
VERCEL_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_KEY=

# ── Database (NeonDB PostgreSQL) ────────────────────────────────────
# Recommended for most uses
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/kairos

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# ── Vercel Blob Storage ─────────────────────────────────────────────
VERCEL_BLOB_READ_WRITE_TOKEN=

# ── Google Login ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
