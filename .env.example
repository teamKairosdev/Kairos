# =============================================================================
# Kairos — Environment Variables
# =============================================================================
# cp .env.example .env 후 값을 채워서 사용하세요.

# ── Google Gemini (AI) ───────────────────────────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Vercel AI Gateway (optional) ──────────────────────────────────────
# Uncomment when using the gateway instead of direct Gemini requests.
# VERCEL_AI_GATEWAY_URL=
# VERCEL_AI_GATEWAY_KEY=

# ── External AI providers (optional, server-only) ──────────────────────
# Model selection order is Gemini, OpenRouter, Ollama/llama.cpp, then the
# generic endpoint unless AI_DEFAULT_MODEL_PROVIDER is set.
# AI_DEFAULT_MODEL_PROVIDER=gemini
# PROVIDER_MAX_OUTPUT_TOKENS=4096
# PROVIDER_ALLOWED_HOSTS=ai.example.com,hermes.example.com
# Set this only when a private RFC1918 endpoint is intentionally required.
# PROVIDER_ALLOW_PRIVATE_NETWORK=false

# OpenRouter (OpenAI-compatible model provider)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=
# OPENROUTER_PROVIDER_LICENSE=
# OPENROUTER_MODEL_LICENSE=
# OPENROUTER_LICENSE_REVIEW=unreviewed

# Ollama or llama.cpp (local SLM; no model is bundled in this repository)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMACPP_MODEL=
# OLLAMA_PROVIDER_LICENSE=
# OLLAMA_MODEL_LICENSE=
# OLLAMA_LICENSE_REVIEW=unreviewed

# Generic OpenAI-compatible endpoint. It requires explicit enablement and
# GENERIC_OPENAI_ALLOWED_HOSTS or PROVIDER_ALLOWED_HOSTS.
# GENERIC_OPENAI_ENABLED=false
# GENERIC_OPENAI_BASE_URL=
# GENERIC_OPENAI_ALLOWED_HOSTS=
# GENERIC_OPENAI_API_KEY=
# GENERIC_OPENAI_MODEL=
# GENERIC_OPENAI_PROVIDER_LICENSE=
# GENERIC_OPENAI_MODEL_LICENSE=
# GENERIC_OPENAI_LICENSE_REVIEW=unreviewed

# External agent runtimes are disabled unless *_ENABLED=true. Their base URL
# is server-side only and is never accepted from a browser request.
# Hermes Agent API Server (OpenAI-compatible; allowlist required)
# HERMES_ENABLED=false
# HERMES_BASE_URL=
# HERMES_API_KEY=
# HERMES_MODEL=
# HERMES_PROVIDER_LICENSE=
# HERMES_MODEL_LICENSE=
# HERMES_LICENSE_REVIEW=unreviewed

# OpenClaw Gateway (trusted local HTTP surface; loopback/private policy applies)
# OPENCLAW_ENABLED=false
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_BEARER_TOKEN=
# OPENCLAW_MODEL=
# OPENCLAW_CHAT_PATH=/v1/chat/completions
# OPENCLAW_HEALTH_PATH=/health
# OPENCLAW_PROVIDER_LICENSE=
# OPENCLAW_MODEL_LICENSE=
# OPENCLAW_LICENSE_REVIEW=unreviewed

# OpenCode server (coding tasks only; bearer or basic auth)
# OPENCODE_ENABLED=false
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_BEARER_TOKEN=
# OPENCODE_AUTH_MODE=bearer
# OPENCODE_USERNAME=
# OPENCODE_PASSWORD=
# OPENCODE_MODEL=
# OPENCODE_PROVIDER_LICENSE=
# OPENCODE_MODEL_LICENSE=
# OPENCODE_LICENSE_REVIEW=unreviewed

# ── PostgreSQL (local development) ───────────────────────────────────
# Local PostgreSQL 16 with pgvector. Replace all POSTGRES_* placeholders.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5432/POSTGRES_DB

# ── Vercel Blob Storage ──────────────────────────────────────────────
# Vercel 대시보드 > Storage > Blob에서 발급
# BLOB_READ_WRITE_TOKEN=

# ── GCP OAuth2 (Google 로그인 직접 연동) ────────────────────────────
# GCP Console > APIs & Services > Credentials에서 발급
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── JWT 세션 시크릿 ────────────────────────────────────────────────
# 최소 32자 이상의 무작위 문자열. openssl rand -base64 32
JWT_SECRET=

# ── Public App URL ─────────────────────────────────────────────────
# OAuth2 redirect URI 등에 사용. 미설정 시 기본값 http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Public career APIs (optional) ─────────────────────────────────────
# Only providers with a non-empty server-side key are called by Context sync.
# Keys are never accepted from the browser and are not stored in the database.
# WORKNET_API_KEY=
# WORKNET_OPEN_API_KEY=
# EMPLOYMENT24_API_KEY=
# EMP24_API_KEY=
# WORK24_API_KEY=
# QNET_API_KEY=
# QNET_SERVICE_KEY=
# DART_API_KEY=
# OPENDART_API_KEY=

# -----------------------------------------------------------------------------
# HWP Editor Studio (optional) ------------------------------------------------
# @rhwp/editor iframe studio URL. Unset = public demo (edwardkim.github.io).
# For confidential docs, self-host rhwp-studio and uncomment this variable:
# NEXT_PUBLIC_RHWP_STUDIO_URL=

# ----------------------------------------------------------------------------
# Sandbox control-plane (optional, disabled by default) -----------------------
# Only the server reads these values. Never use NEXT_PUBLIC_ variables here.
# `remote-firecracker` is used only by a Linux server with both endpoint/token.
# `windows-sandbox` only generates and validates a .wsb config; it never starts it.
SANDBOX_BACKEND=disabled
# SANDBOX_FIRECRACKER_ENDPOINT=https://firecracker.example.internal/api/jobs
# SANDBOX_FIRECRACKER_TOKEN=
# SANDBOX_WINDOWS_MEMORY_MB=2048
# SANDBOX_WINDOWS_CPUS=2
# SANDBOX_WINDOWS_NETWORK=Disable
# SANDBOX_WINDOWS_VGPU=Disable
