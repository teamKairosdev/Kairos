# =============================================================================
# Kairos — Environment Variables
# =============================================================================
# .env 파일로 복사해서 사용하세요.
# 단 하나의 LLM API 키만 있으면 모든 AI 기능이 작동합니다.

# ── LLM Provider (셋 중 하나만 필수) ──────────────────────────────────────
# 우선순위: Google (Gemini) > Anthropic > OpenAI
# VERCEL_AI_GATEWAY_URL을 설정하면 모든 LLM 호출이 Gateway를 통해 라우팅됩니다.
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/kairos

# ── Security ────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=

# ── Toss Payments (선택) ───────────────────────────────────────────────────
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── Social Login OAuth (선택) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── Upstash Redis (선택) ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── VAPID Web Push (선택) ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kairos.app

# ── Vercel AI Gateway (선택) ───────────────────────────────────────────────
# 설정 시 모든 AI SDK 호출이 Gateway URL을 경유합니다 (SSRF 방지, 캐싱, 로깅).
VERCEL_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_KEY=
